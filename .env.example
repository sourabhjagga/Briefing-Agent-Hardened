# ─── TELEGRAM BOT CONFIGURATION ─────────────────────────────────────────
# Token of the main credit card Telegram bot (obtain from @BotFather)
TELEGRAM_BOT_TOKEN=your_cc_bot_token_here

# Token of the deals Telegram bot (optional, defaults to CC bot if omitted)
DEALS_BOT_TOKEN=your_deals_bot_token_here

# Your personal Telegram Chat ID (where summaries and alerts will be sent)
TELEGRAM_CHAT_ID=your_personal_chat_id_here

# ─── CUSTOM CATEGORIES ─────────────────────────────────────────────────
# Additional briefing categories (e.g., Office, Crypto, Fitness) can be
# created and configured entirely through the Web Dashboard at runtime.
# Each custom category supports its own:
#   - Telegram Bot Token (from @BotFather)
#   - Chat ID (your personal or group chat)
#   - AI Prompt (customized summarization instructions)
# No environment variables needed for custom categories — manage them via the dashboard.

# ─── TELEGRAM PERSONAL API CREDENTIALS ──────────────────────────────────
# Required for scraping private subscribed Telegram channels (get from my.telegram.org)
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# ─── AI MODELS & CREDENTIALS ────────────────────────────────────────────
# Gemini API Key (obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter Key (obtain from openrouter.ai - used for fallback to free models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── SERVER CONFIGURATION ───────────────────────────────────────────────
# Port for the web dashboard and health check (Coolify proxy routes to this)
HEALTH_PORT=3000

# ─── DASHBOARD API AUTHENTICATION ───────────────────────────────────────
# Required. All /api/* routes reject requests without this key in the
# X-API-Key header (except /health and the signed webhook endpoints).
# Generate with: openssl rand -hex 32
# The same value is passed to the static dashboard build as NEXT_PUBLIC_API_KEY
# (GitHub Actions secret DASHBOARD_API_KEY) so the browser authenticates.
DASHBOARD_API_KEY=your_dashboard_api_key_here

# ─── SCHEDULER SETTINGS (IST TIMEZONE) ──────────────────────────────────
# Daily briefing triggers default to 6:00 AM, 2:00 PM, and 10:00 PM IST
SUMMARY_HOUR=22
SUMMARY_MINUTE=00

# ─── WHATSAPP INITIAL SEED TARGETS (OPTIONAL) ───────────────────────────
# Comma-separated list of WhatsApp group/channel IDs (e.g. 120363xxx@g.us,120363yyy@newsletter)
# You can also add these dynamically via the Web Dashboard
WHATSAPP_GROUPS=

# ─── PROXY CONFIGURATION (OPTIONAL) ─────────────────────────────────────
# SOCKS5 or HTTP/HTTPS proxy to bypass network restrictions for Telegram API
# Example: socks5://username:password@ip:port or http://ip:port
TELEGRAM_PROXY=

# ─── REDDIT API CREDENTIALS (OPTIONAL) ───────────────────────────────────
# Optional: For higher rate limits on Reddit API (OAuth)
# Get from https://www.reddit.com/prefs/apps (create a "script" app)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=cc-brief-agent/v1

# ─── SCRAPER LOGIN CREDENTIALS (OPTIONAL) ───────────────────────────────
# Used by forum/reddit scrapers where sessions require a login.
TECHNOFINO_USERNAME=your_technofino_username_here
TECHNOFINO_PASSWORD=your_technofino_password_here
DESIDIME_USERNAME=your_desidime_username_here
DESIDIME_PASSWORD=your_desidime_password_here
REDDIT_USERNAME=your_reddit_username_here
REDDIT_PASSWORD=your_reddit_password_here

